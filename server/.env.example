PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
# Optional: comma-separated allowed origins when a reverse proxy changes the
# browser origin seen by the API. Keep the API behind that trusted proxy.
# ALLOWED_ORIGINS=https://your-site.example
